---
import Layout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { calculateReadingTime } from "../../utils/readingTime";

// načtení článků z Notion syncu
const posts = await getCollection("blog");

// seřazení
const sorted = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date));

const visiblePosts = sorted.map((post) => ({
  ...post,
  readingTime: calculateReadingTime(post.body),
}));



---

<Layout title="Blog | Matěj Zelinka">

<!-- ================= BLOG HERO (TVŮJ FINÁL) ================= -->

<section
  id="blog-hero"
  class="relative mx-auto max-w-7xl px-6 pt-28 pb-20 overflow-hidden"
>
  <!-- Gradient base -->
  <div class="absolute inset-0 -z-20 bg-gradient-to-b from-indigo-500/10 via-transparent to-transparent"></div>

  <!-- Grid overlay -->
  <div
    class="absolute inset-0 -z-20 opacity-[0.06]"
    style="
      background-image:
        linear-gradient(to right, rgba(255,255,255,0.12) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,255,255,0.12) 1px, transparent 1px);
      background-size: 72px 72px;
    "
  ></div>

  <!-- Noise -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.025]"
    style="
      background-image: url('data:image/svg+xml;utf8,\
<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"200\">\
<filter id=\"n\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.85\" numOctaves=\"4\" stitchTiles=\"stitch\"/></filter>\
<rect width=\"100%\" height=\"100%\" filter=\"url(%23n)\" opacity=\"0.4\"/>\
</svg>');
    "
  ></div>

  <!-- Ambient blobs -->
  <div
    class="absolute -top-48 -right-48 w-[420px] h-[420px] bg-indigo-600/15 blur-[160px] rounded-full -z-10"
  ></div>

  <div
    id="blog-ambient"
    class="absolute top-1/2 -left-40 w-[360px] h-[360px] bg-fuchsia-600/10 blur-[160px] rounded-full -z-20"
  ></div>

  <!-- Logo -->
  <div class="mb-10 relative z-10">
    <img
      src="/mz-logo.png"
      alt="Matěj Zelinka logo"
      class="h-16 md:h-20 w-auto drop-shadow-[0_0_22px_rgba(99,102,241,0.35)]"
    />
  </div>

  <!-- Heading -->
  <header class="relative z-10 max-w-3xl">
    <h1
      class="text-4xl md:text-5xl lg:text-6xl font-semibold tracking-tight leading-tight"
    >
      Blog
    </h1>

  </header>

  <!-- Motion script -->
  <script is:inline>
    const ambient = document.getElementById("blog-ambient");
    const hero = document.getElementById("blog-hero");

    let mouseX = -999;
    let mouseY = -999;

    hero.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    });

    hero.addEventListener("mouseleave", () => {
      mouseX = -999;
      mouseY = -999;
    });

    function animate() {
      if (ambient) {
        ambient.style.transform =
          "translate(" + mouseX * 0.015 + "px, " + mouseY * 0.015 + "px)";
      }

      requestAnimationFrame(animate);
    }

    animate();
  </script>
</section>

<!-- ================= GRID ČLÁNKŮ ================= -->

<section class="mx-auto max-w-7xl px-6 pb-32">

  <div class="grid gap-y-20">

    {visiblePosts.map((post) => (
      <article class="group grid gap-8 lg:grid-cols-12 items-start">

        <!-- IMAGE -->
        <a
          href={`/blog/${post.slug}`}
          class="relative overflow-hidden rounded-xl bg-zinc-900 lg:col-span-4 aspect-[16/9]"

        >
          <img
            src={post.data.cover}
            alt={post.data.title}
            class="h-full w-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-[1.03]"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent" />
        </a>

        <!-- CONTENT -->
        <div class="lg:col-span-8 flex flex-col justify-center">

          {post.data.tags?.[0] && (() => {
  const TAG_COLORS = {
    blue: "bg-blue-500/10 text-blue-300 border-blue-400/30",
    purple: "bg-purple-500/10 text-purple-300 border-purple-400/30",
    green: "bg-emerald-500/10 text-emerald-300 border-emerald-400/30",
    red: "bg-red-500/10 text-red-300 border-red-400/30",
    yellow: "bg-yellow-500/10 text-yellow-300 border-yellow-400/30",
    orange: "bg-orange-500/10 text-orange-300 border-orange-400/30",
    pink: "bg-pink-500/10 text-pink-300 border-pink-400/30",
    gray: "bg-slate-500/10 text-slate-300 border-slate-400/30",
  };

  return (
    <span
      class={`mb-2 inline-block rounded-full border px-3 py-1 text-xs uppercase tracking-wide font-semibold ${
        TAG_COLORS[post.data.tags[0].color] ??
        TAG_COLORS.gray
      }`}
    >
      {post.data.tags[0].name}
    </span>
  );
})()}


          <h2 class="text-2xl md:text-3xl font-semibold leading-tight">

            <a
              href={`/blog/${post.slug}`}
              class="hover:underline underline-offset-4 decoration-zinc-500"
            >
              {post.data.title}
            </a>
          </h2>

          <p class="mt-3 text-sm text-zinc-400 max-w-xl">
            {post.data.excerpt}
          </p>

          <div class="mt-5 flex items-center gap-4 text-xs text-zinc-500">
            <time>
  {post.data.date.toLocaleDateString("cs-CZ")}
</time>

            <span>•</span>
          
<span>{post.readingTime} min</span>



          </div>

        </div>

      </article>
    ))}

  </div>

</section>



</Layout>
