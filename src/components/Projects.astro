    </div>
  </div>

  <!-- NAV -->
  <div class="mt-16 flex justify-center gap-20">

    <button
      id="projects-prev"
      class="text-slate-400 hover:text-indigo-400 transition drop-shadow-[0_0_12px_rgba(99,102,241,0.35)]"
    >
      <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 6L9 14l8 8" />
      </svg>
    </button>

    <button
      id="projects-next"
      class="text-slate-400 hover:text-indigo-400 transition drop-shadow-[0_0_12px_rgba(99,102,241,0.35)]"
    >
      <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 6l8 8-8 8" />
      </svg>
    </button>

  </div>

  
</section>

<script>
  const mask = document.getElementById("projects-mask");
  const track = document.getElementById("projects-track");
  const next = document.getElementById("projects-next");
  const prev = document.getElementById("projects-prev");

  let index = 0;
  let startX = 0;
  let isDragging = false;

  function getCardWidth() {
    const card = track.children[0];
    const gap = parseFloat(getComputedStyle(track).gap || 0);
    return card.offsetWidth + gap;
  }

  function updateMask() {
    mask.classList.remove("fade-left", "fade-right", "fade-both");

    const maxIndex = track.children.length - 1;

    if (index === 0) {
      mask.classList.add("fade-right");
    } else if (index >= maxIndex - 1) {
      mask.classList.add("fade-left");
    } else {
      mask.classList.add("fade-both");
    }
  }

  function goNext() {
    const cardWidth = getCardWidth();
    index = Math.min(track.children.length - 2, index + 1);
    track.style.transform = `translateX(-${index * cardWidth}px)`;
    updateMask();
  }

  function goPrev() {
    const cardWidth = getCardWidth();
    index = Math.max(0, index - 1);
    track.style.transform = `translateX(-${index * cardWidth}px)`;
    updateMask();
  }

  next.addEventListener("click", goNext);
  prev.addEventListener("click", goPrev);

  mask.addEventListener(
  "touchstart",
  (e) => {
    startX = e.touches[0].clientX;
    isDragging = true;
  },
  { passive: true }
);

mask.addEventListener(
  "touchend",
  (e) => {
    if (!isDragging) return;

    const diff = startX - e.changedTouches[0].clientX;

    if (Math.abs(diff) > 60) {
      diff > 0 ? goNext() : goPrev();
    }

    isDragging = false;
  },
  { passive: true }
);

mask.addEventListener("mousedown", (e) => {
  startX = e.clientX;
  isDragging = true;
});

mask.addEventListener("mouseup", (e) => {
  if (!isDragging) return;

  const diff = startX - e.clientX;

  if (Math.abs(diff) > 80) {
    diff > 0 ? goNext() : goPrev();
  }

  isDragging = false;
});

mask.addEventListener("mouseleave", () => {
  isDragging = false;
});


  updateMask();
</script>

