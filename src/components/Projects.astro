<section
  id="projects"
  class="relative px-6 py-32 md:px-12 lg:px-24 max-w-7xl mx-auto overflow-hidden"
>
  <div class="mb-20 max-w-2xl">
    <h2 class="pb-1 leading-[1.3] text-3xl md:text-4xl font-bold bg-gradient-to-r from-slate-200 to-slate-400 bg-clip-text text-transparent">
      Moje projekty
    </h2>
    <p class="mt-4 text-slate-400">
      Vlastní digitální produkty, které dlouhodobě rozvíjím.
    </p>
  </div>

  <div id="projects-mask" class="relative">
    <div
  id="projects-track"
  class="carousel-track flex gap-12"
>

      <slot />
    </div>
  </div>

  <div class="mt-16 flex justify-center gap-20">
    <button id="projects-prev" class="text-slate-400 hover:text-indigo-400 transition">
      ‹
    </button>
    <button id="projects-next" class="text-slate-400 hover:text-indigo-400 transition">
      ›
    </button>
  </div>

  <script>
    const mask = document.getElementById("projects-mask");
    const track = document.getElementById("projects-track");
    const next = document.getElementById("projects-next");
    const prev = document.getElementById("projects-prev");
  
  next.addEventListener("click", () => {
    track.scrollBy({
      left: mask.offsetWidth,
      behavior: "smooth",
    });
  });

  prev.addEventListener("click", () => {
    track.scrollBy({
      left: -mask.offsetWidth,
      behavior: "smooth",
    });
  });
</script>