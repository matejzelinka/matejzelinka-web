<section
  id="hero-experimental"
  class="min-h-screen flex flex-col justify-center px-6 pt-10 pb-16 md:px-12 lg:px-24 max-w-5xl mx-auto relative overflow-x-hidden"
>

  <!-- Static gradient base -->
  <div class="absolute inset-0 -z-20 bg-gradient-to-b from-indigo-500/10 via-transparent to-transparent"></div>

  <!-- Grid overlay -->
<div
  class="absolute inset-0 -z-20 opacity-[0.08]"
  style="
    background-image:
      linear-gradient(to right, rgba(255,255,255,0.15) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.15) 1px, transparent 1px);
    background-size: 64px 64px;
  "
></div>

<!-- Noise overlay -->
<div
  class="pointer-events-none absolute inset-0 -z-10 opacity-[0.03]"
  style="
    background-image: url('data:image/svg+xml;utf8,\
<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"200\">\
<filter id=\"n\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"4\" stitchTiles=\"stitch\"/></filter>\
<rect width=\"100%\" height=\"100%\" filter=\"url(%23n)\" opacity=\"0.4\"/>\
</svg>');
  "
></div>

<canvas
  id="hero-particles"
  class="pointer-events-none absolute inset-0 -z-10"
></canvas>


  <div
  id="hero-glow"
  class="pointer-events-none absolute inset-0 -z-10 opacity-40 blur-2xl transition duration-500"
></div>


  <!-- Ambient blob -->
  <div
    class="absolute -top-40 -right-40 w-[520px] h-[520px] bg-indigo-600/20 blur-[140px] rounded-full -z-10"
  ></div>

  <!-- Secondary ambient glow -->
<div
  id="hero-ambient"
  class="absolute top-1/3 -left-40 w-[480px] h-[480px] bg-fuchsia-600/10 blur-[160px] rounded-full -z-20"
></div>


  <!-- Logo -->
  <div class="mb-12 relative z-10">
    <img
      src="/mz-logo.png"
      alt="Matěj Zelinka logo"
      class="h-20 md:h-28 w-auto drop-shadow-[0_0_28px_rgba(99,102,241,0.35)]"
    />
  </div>

  <h1
  id="hero-title"
  class="text-4xl md:text-5xl lg:text-6xl font-bold mb-8 opacity-0 translate-y-6 transition-all duration-1000"
>
  <span
    class="inline-block pb-1 leading-[1.3] bg-gradient-to-r from-slate-200 via-slate-200 to-slate-400 bg-clip-text text-transparent"
  >
    Digitální komunikace, obsah a projekty, které mají smysl.
  </span>
</h1>



  <p
    class="relative z-10 text-lg md:text-xl text-slate-400 mb-12 max-w-3xl leading-relaxed"
  >
    Jmenuji se Matěj Zelinka. Přes deset let se věnuji správě sociálních sítí,
    digitálním kampaním a projektům ve veřejné správě, politickém marketingu a
    neziskovém sektoru. Propojuji obsah, strategii a technologie – včetně
    praktického využití AI.
  </p>

  <div class="relative z-10 flex flex-col sm:flex-row gap-4">
    <a
      href="#projects"
      class="inline-block bg-gradient-to-r from-indigo-500 to-indigo-600 text-white px-8 py-4 font-semibold hover:from-indigo-600 hover:to-indigo-700 transition-all text-center rounded-sm shadow-lg shadow-indigo-500/50"
    >
      Projekty
    </a>

    <a
      href="#timeline"
      class="inline-block border border-slate-700 text-slate-300 px-8 py-4 font-semibold hover:bg-slate-800/50 hover:border-slate-600 transition-all text-center rounded-sm"
    >
      Jak jsem se sem dostal
    </a>
  </div>

  <script is:inline>
  const glow = document.getElementById("hero-glow");
  const ambient = document.getElementById("hero-ambient");

  let mouseX = 0;
  let mouseY = 0;

  const hero = document.getElementById("hero-experimental");

hero.addEventListener("mousemove", (e) => {
  const rect = hero.getBoundingClientRect();

  mouseX = e.clientX - rect.left;
  mouseY = e.clientY - rect.top;
});

hero.addEventListener("mouseleave", () => {
  mouseX = -999;
  mouseY = -999;
});


  function animate() {
    if (glow) {
      glow.style.background =
  "radial-gradient(380px at " +
  mouseX +
  "px " +
  mouseY +
  "px, rgba(99,102,241,0.35), transparent 60%)";
}

    if (ambient) {
      ambient.style.transform =
        "translate(" + mouseX * 0.02 + "px, " + mouseY * 0.02 + "px)";
    }

    requestAnimationFrame(animate);
  }

  animate();

  const title = document.getElementById("hero-title");

if (title) {
  requestAnimationFrame(() => {
    title.classList.remove("opacity-0", "translate-y-6");
  });
}

const canvas = document.getElementById("hero-particles");
const heroEl = document.getElementById("hero-experimental");

if (canvas && heroEl) {
  const ctx = canvas.getContext("2d");

  function resize() {
    canvas.width = heroEl.offsetWidth;
    canvas.height = heroEl.offsetHeight;
  }

  resize();
  window.addEventListener("resize", resize);

  const COUNT = 35;
  const particles = [];

  for (let i = 0; i < COUNT; i++) {
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: Math.random() * 1.5 + 0.5,
      vy: Math.random() * 0.15 + 0.05,
      vx: Math.random() * 0.2 - 0.1,
      alpha: Math.random() * 0.53 + 0.03,
    });
  }

  let mouse = { x: null, y: null };

  heroEl.addEventListener("mousemove", (e) => {
    const rect = heroEl.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
  });

  heroEl.addEventListener("mouseleave", () => {
    mouse.x = null;
    mouse.y = null;
  });

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    particles.forEach((p) => {
      // move
      p.y += p.vy;
      p.x += p.vx;

      // respawn at top
      if (p.y > canvas.height) {
        p.y = -10;
        p.x = Math.random() * canvas.width;
      }

      // subtle mouse drift
      if (mouse.x !== null) {
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < 160) {
          p.x += dx * 0.01;
          p.y += dy * 0.01;
        }
      }

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(180,200,255," + p.alpha + ")";
      ctx.fill();
    });

    requestAnimationFrame(draw);
  }

  draw();
}


</script>


</section>
