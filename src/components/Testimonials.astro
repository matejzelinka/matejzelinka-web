<section
  id="testimonials"
  class="relative px-6 py-20 md:px-12 lg:px-24 max-w-7xl mx-auto overflow-hidden"
>
  <div class="max-w-4xl w-full mx-auto">

    <!-- Main Card -->
    <div class="relative p-6 md:p-8">

      <!-- Header -->
      <div class="text-center mb-4">
        

        <h2
          class="pb-1 leading-[1.3] text-3xl md:text-4xl font-bold bg-gradient-to-r from-slate-200 to-slate-400 bg-clip-text text-transparent"

        >
          Co říkají klienti
        </h2>

        
      </div>

      <!-- Testimonials Container -->
      <div class="relative min-h-[280px]">

        <!-- Avatar Section -->
        <div class="flex justify-center mb-4">
          <div class="avatar-wrapper">
            <div class="avatar active" data-index="0">
              <img
                src="/testimonials/ref1.jpg"
                alt="Jessie J"
                class="w-full h-full object-cover rounded-full border-2 border-indigo-500 shadow-lg shadow-indigo-500/50"
              />
            </div>

            <div class="avatar hidden" data-index="1">
              <img
                src="/testimonials/ref2.jpg"
                alt="Mark Luk"
                class="w-full h-full object-cover rounded-full border-2 border-indigo-500 shadow-lg shadow-indigo-500/50"
              />
            </div>

            <div class="avatar hidden" data-index="2">
              <img
                src="/testimonials/ref3.jpg"
                alt="Jeff Kahl"
                class="w-full h-full object-cover rounded-full border-2 border-indigo-500 shadow-lg shadow-indigo-500/50"
              />
            </div>
          </div>
        </div>

        <!-- Testimonial Cards -->
        <div class="relative">

          <div class="testimonial-card active" data-index="0">
            <div class="text-center max-w-2xl mx-auto">
              <div class="text-indigo-400 text-4xl mb-2 opacity-30">"</div>

              <p
                class="mt-4 text-slate-400"
              >
                Schopnost zachytit odpovědi je zásadní změna. Pokud uživatel
                přestane vyplňovat formulář a odejde, data jsou stále uložena.
                Navíc je skvělé moci si vybrat mezi formáty.
              </p>
            </div>
          </div>

          <div class="testimonial-card hidden" data-index="1">
            <div class="text-center max-w-2xl mx-auto">
              <div class="text-indigo-400 text-4xl mb-2 opacity-30">"</div>

              <p
                class="mt-4 text-slate-400"
              >
                Tento produkt používám již několik týdnů a jsem naprosto
                ohromený výsledky. Má pleť vypadá viditelně svěžeji a hladčeji a
                dostávám spoustu komplimentů na mou pleť.
              </p>
            </div>
          </div>

          <div class="testimonial-card hidden" data-index="2">
            <div class="text-center max-w-2xl mx-auto">
              <div class="text-indigo-400 text-4xl mb-2 opacity-30">"</div>

              <p
                class="mt-4 text-slate-400"
              >
                Jako zaneprázdněný profesionál nemám moc času na cvičení. Ale s
                tímto fitness programem jsem dosáhl úžasných výsledků za pár
                týdnů. Tréninky jsou efektivní a účinné.
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="flex flex-wrap justify-center gap-3 mt-2">
        <button class="testimonial-btn active" data-index="0">
          <span class="font-medium">Jessie J</span>
          <span class="mx-1.5">-</span>
          <span class="opacity-80">Ltd</span>
          <div class="progress"></div>
        </button>

        <button class="testimonial-btn" data-index="1">
          <span class="font-medium">Mark Luk</span>
          <span class="mx-1.5">-</span>
          <span class="opacity-80">Spark</span>
          <div class="progress"></div>
        </button>

        <button class="testimonial-btn" data-index="2">
          <span class="font-medium">Jeff Kahl</span>
          <span class="mx-1.5">-</span>
          <span class="opacity-80">Appy</span>
          <div class="progress"></div>
        </button>
      </div>

    </div>
  </div>

  <script is:inline>
    let currentIndex = 0;
    let autoplayInterval;
    const autoplayDuration = 7000;

    const testimonialCards = document.querySelectorAll(
      "#testimonials .testimonial-card"
    );
    const avatars = document.querySelectorAll("#testimonials .avatar");
    const buttons = document.querySelectorAll("#testimonials .testimonial-btn");

    function showTestimonial(index) {
      if (testimonialCards[currentIndex]) {
        testimonialCards[currentIndex].classList.add("leaving");
      }

      setTimeout(() => {
        testimonialCards.forEach((card, i) => {
          card.classList.remove("leaving");

          if (i === index) {
            card.classList.remove("hidden");
            card.classList.add("active");
          } else {
            card.classList.add("hidden");
            card.classList.remove("active");
          }
        });

        avatars.forEach((avatar, i) => {
          if (i === index) {
            avatar.classList.remove("hidden");
            avatar.classList.add("active");
          } else {
            avatar.classList.add("hidden");
            avatar.classList.remove("active");
          }
        });

        buttons.forEach((btn, i) => {
          btn.classList.toggle("active", i === index);
        });

        currentIndex = index;
      }, 100);
    }

    function nextTestimonial() {
      showTestimonial((currentIndex + 1) % testimonialCards.length);
    }

    function startAutoplay() {
      autoplayInterval = setInterval(nextTestimonial, autoplayDuration);
    }

    function stopAutoplay() {
      clearInterval(autoplayInterval);
    }

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => {
        showTestimonial(index);
        stopAutoplay();
        startAutoplay();
      });
    });

    startAutoplay();
  </script>
</section>
