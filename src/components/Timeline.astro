<section
  id="timeline"
  class="px-6 py-24 md:px-12 lg:px-24 max-w-4xl mx-auto"
>
  <h2
    class="text-3xl md:text-4xl font-bold mb-16 bg-gradient-to-r from-slate-200 to-slate-400 bg-clip-text text-transparent"
  >
    Jak jsem se sem dostal
  </h2>

  <div class="space-y-16">

    <!-- ITEM -->
    <div
      class="timeline-item grid grid-cols-[32px_1fr] gap-8 opacity-0 translate-y-6 transition-all duration-700 ease-out"
    >
      <!-- DOT + LINE -->
      <div class="flex flex-col items-center">
        <div class="timeline-dot w-4 h-4 bg-slate-600 rounded-full transition-all duration-700"></div>
        <div class="w-0.5 flex-1 bg-gradient-to-b from-slate-700 to-transparent mt-2"></div>
      </div>

      <!-- CONTENT -->
      <div>
        <div class="flex items-center h-4 mb-2">
          <span class="text-sm font-medium text-indigo-400">
            od cca 13 let
          </span>
        </div>
        <h3 class="font-semibold text-xl mb-2 text-slate-200">
          Dobrovolnictví jako základ všeho
        </h3>
        <p class="text-slate-400">
          Už od třinácti let se pohybuji v prostředí nezisku a práce s dětmi. Od
          dobrovolnictví jsem se postupně dostal k organizování a koordinaci
          větších akcí pro mládež. Právě tady vznikl můj vztah k práci s lidmi,
          odpovědnosti a dlouhodobému přemýšlení o projektech — dávno předtím,
          než jsem se začal věnovat marketingu nebo technologiím.
        </p>
      </div>
    </div>

    <!-- ITEM -->
    <div
      class="timeline-item grid grid-cols-[32px_1fr] gap-8 opacity-0 translate-y-6 transition-all duration-700 ease-out"
    >
      <div class="flex flex-col items-center">
        <div class="timeline-dot w-4 h-4 bg-slate-600 rounded-full transition-all duration-700"></div>
        <div class="w-0.5 flex-1 bg-gradient-to-b from-slate-700 to-transparent mt-2"></div>
      </div>

      <div>
        <div class="flex items-center h-4 mb-2">
          <span class="text-sm font-medium text-indigo-400">
            2007 →
          </span>
        </div>
        <h3 class="font-semibold text-xl mb-2 text-slate-200">
          Práce s lidmi, vzdělávání a kultura
        </h3>
        <p class="text-slate-400">
          Na tyto zkušenosti přirozeně navázala práce ve vzdělávání, kultuře a
          neziskovém sektoru. Upevnil jsem si schopnost komunikovat s různými
          skupinami, vést lidi a převádět složité věci do srozumitelné podoby.
          Tahle etapa mě naučila dívat se na projekty v širších souvislostech.
        </p>
      </div>
    </div>

    <!-- ITEM -->
    <div
      class="timeline-item grid grid-cols-[32px_1fr] gap-8 opacity-0 translate-y-6 transition-all duration-700 ease-out"
    >
      <div class="flex flex-col items-center">
        <div class="timeline-dot w-4 h-4 bg-slate-600 rounded-full transition-all duration-700"></div>
        <div class="w-0.5 flex-1 bg-gradient-to-b from-slate-700 to-transparent mt-2"></div>
      </div>

      <div>
        <div class="flex items-center h-4 mb-2">
          <span class="text-sm font-medium text-indigo-400">
            2013 →
          </span>
        </div>
        <h3 class="font-semibold text-xl mb-2 text-slate-200">
          Přechod k digitální komunikaci
        </h3>
        <p class="text-slate-400">
          Od roku 2013 se systematicky věnuji správě webů a sociálních sítí,
          zejména ve veřejné správě a neziskovém sektoru. Postupně jsem přešel
          od tvorby obsahu ke strategii a řízení digitální komunikace.
        </p>
      </div>
    </div>

    <!-- ITEM -->
    <div
      class="timeline-item grid grid-cols-[32px_1fr] gap-8 opacity-0 translate-y-6 transition-all duration-700 ease-out"
    >
      <div class="flex flex-col items-center">
        <div class="timeline-dot w-4 h-4 bg-slate-600 rounded-full transition-all duration-700"></div>
        <div class="w-0.5 flex-1 bg-gradient-to-b from-slate-700 to-transparent mt-2"></div>
      </div>

      <div>
        <div class="flex items-center h-4 mb-2">
          <span class="text-sm font-medium text-indigo-400">
            2020 →
          </span>
        </div>
        <h3 class="font-semibold text-xl mb-2 text-slate-200">
          Kampaně, reputace a krizová komunikace
        </h3>
        <p class="text-slate-400">
          S příchodem politických a veřejných kampaní se moje práce posunula
          k placené reklamě, cílení, práci s reputací a krizové komunikaci.
          Řešil jsem situace, kde komunikace není „hezká“, ale zásadní.
        </p>
      </div>
    </div>

    <!-- ITEM -->
    <div
      class="timeline-item grid grid-cols-[32px_1fr] gap-8 opacity-0 translate-y-6 transition-all duration-700 ease-out"
    >
      <div class="flex flex-col items-center">
        <div class="timeline-dot w-4 h-4 bg-slate-600 rounded-full transition-all duration-700"></div>
      </div>

      <div>
        <div class="flex items-center h-4 mb-2">
          <span class="text-sm font-medium text-indigo-400">
            2024 →
          </span>
        </div>
        <h3 class="font-semibold text-xl mb-2 text-slate-200">
          Technologie a AI jako nástroj, ne cíl
        </h3>
        <p class="text-slate-400">
          V posledních letech se intenzivně věnuji využití AI v komunikaci a
          marketingu — ne jako módnímu trendu, ale jako praktickému nástroji,
          který šetří čas, zpřesňuje práci a dává prostor lidské části
          komunikace.
        </p>
      </div>
    </div>

  </div>

  <!-- SCROLL ANIMATION -->
  <script>
    const items = document.querySelectorAll(".timeline-item");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-6");

            const dot = entry.target.querySelector(".timeline-dot");
            if (dot) {
              dot.classList.add(
                "bg-gradient-to-r",
                "from-indigo-500",
                "to-indigo-600",
                "scale-110",
                "shadow-lg",
                "shadow-indigo-500/50"
              );
            }

            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 }
    );

    items.forEach((item) => observer.observe(item));
  </script>
</section>
