---
import { getCollection } from "astro:content";

const TAG_COLORS = {
  blue: "bg-blue-500/10 text-blue-300 border-blue-400/30",
  purple: "bg-purple-500/10 text-purple-300 border-purple-400/30",
  green: "bg-emerald-500/10 text-emerald-300 border-emerald-400/30",
  red: "bg-red-500/10 text-red-300 border-red-400/30",
  yellow: "bg-yellow-500/10 text-yellow-300 border-yellow-400/30",
  orange: "bg-orange-500/10 text-orange-300 border-orange-400/30",
  pink: "bg-pink-500/10 text-pink-300 border-pink-400/30",
  gray: "bg-slate-500/10 text-slate-300 border-slate-400/30",
};

const posts = await getCollection("blog");

posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = posts.slice(0, 7);
---

<section
  id="blog"
  class="relative px-6 py-32 md:px-12 lg:px-24 max-w-7xl mx-auto overflow-hidden"
>
  <div class="mb-20 max-w-2xl">
    <h2
      class="pb-1 leading-[1.3] text-3xl md:text-4xl font-bold bg-gradient-to-r from-slate-200 to-slate-400 bg-clip-text text-transparent"
    >
      Texty & blog
    </h2>
    <p class="mt-4 text-slate-400">
      Píšu o marketingu, technologiích, AI a stavbě vlastních projektů.
    </p>
  </div>

  <div id="blog-mask" class="relative">
    <div
      id="blog-track"
      class="flex gap-10 transition-transform duration-700 ease-out will-change-transform"
    >
      {featured.map((post) => (
        <a href={`/blog/${post.slug}`} class="blog-card block">
          <img src={post.data.cover} class="thumb" />

          <div class="body">
            {post.data.tags && (
  <div class="flex flex-wrap gap-2">
    {post.data.tags.map((tag) => (
   

<span
  class={`inline-block mr-3 mb-4 rounded-full border px-3 py-1 text-xs uppercase tracking-wide font-semibold ${
    TAG_COLORS[tag.color] ?? TAG_COLORS.gray
  }`}
>


        {tag.name}
      </span>


    ))}
  </div>
)}


            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
            <span class="blog-cta">Číst článek →</span>

          </div>
        </a>
      ))}

      <a href="/blog" class="blog-more block">
        <div>
          <p>Více článků najdete v blogu</p>
          <span>Přejít na blog →</span>
        </div>
      </a>
    </div>
  </div>

<!-- NAV -->
  <div class="mt-16 flex justify-center gap-20">

    <button
      id="blog-prev"
      class="text-slate-400 hover:text-indigo-400 transition drop-shadow-[0_0_12px_rgba(99,102,241,0.35)]"
    >
      <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 6L9 14l8 8" />
      </svg>
    </button>

    <button
      id="blog-next"
      class="text-slate-400 hover:text-indigo-400 transition drop-shadow-[0_0_12px_rgba(99,102,241,0.35)]"
    >
      <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 6l8 8-8 8" />
      </svg>
    </button>

  </div>

</section>

<script>
  const mask = document.getElementById("blog-mask");
  const track = document.getElementById("blog-track");
  const next = document.getElementById("blog-next");
  const prev = document.getElementById("blog-prev");

  let index = 0;
  let startX = 0;
  let isDragging = false;

  function getCardWidth() {
    const card = track.children[0];
    const gap = parseFloat(getComputedStyle(track).gap || 0);
    return card.offsetWidth + gap;
  }

  function updateMask() {
    mask.classList.remove("fade-left", "fade-right", "fade-both");

    const maxIndex = track.children.length - 1;

    if (index === 0) {
      mask.classList.add("fade-right");
    } else if (index >= maxIndex - 1) {
      mask.classList.add("fade-left");
    } else {
      mask.classList.add("fade-both");
    }
  }

  function goNext() {
    const cardWidth = getCardWidth();
    index = Math.min(track.children.length - 2, index + 1);
    track.style.transform = `translateX(-${index * cardWidth}px)`;
    updateMask();
  }

  function goPrev() {
    const cardWidth = getCardWidth();
    index = Math.max(0, index - 1);
    track.style.transform = `translateX(-${index * cardWidth}px)`;
    updateMask();
  }

  next.addEventListener("click", goNext);
  prev.addEventListener("click", goPrev);

  // 👉 SWIPE MOBILE + DESKTOP DRAG
  track.addEventListener(
    "touchstart",
    (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
    },
    { passive: true }
  );

  track.addEventListener(
    "touchend",
    (e) => {
      if (!isDragging) return;

      const diff = startX - e.changedTouches[0].clientX;

      if (Math.abs(diff) > 60) {
        diff > 0 ? goNext() : goPrev();
      }

      isDragging = false;
    },
    { passive: true }
  );

  track.addEventListener("mousedown", (e) => {
    startX = e.clientX;
    isDragging = true;
  });

  track.addEventListener("mouseup", (e) => {
    if (!isDragging) return;

    const diff = startX - e.clientX;

    if (Math.abs(diff) > 80) {
      diff > 0 ? goNext() : goPrev();
    }

    isDragging = false;
  });

  track.addEventListener("mouseleave", () => {
    isDragging = false;
  });

  updateMask();
</script>
